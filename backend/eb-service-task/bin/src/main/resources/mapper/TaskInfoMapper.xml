<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.enterprise.brain.task.mapper.TaskInfoMapper">

    <resultMap id="TaskInfoResultMap" type="com.enterprise.brain.task.entity.TaskInfo">
        <id column="id" property="id"/>
        <result column="task_no" property="taskNo"/>
        <result column="external_task_id" property="externalTaskId"/>
        <result column="external_system" property="externalSystem"/>
        <result column="task_type" property="taskType"/>
        <result column="task_category" property="taskCategory"/>
        <result column="priority" property="priority"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="biz_key" property="bizKey"/>
        <result column="biz_url" property="bizUrl"/>
        <result column="initiator_id" property="initiatorId"/>
        <result column="initiator_name" property="initiatorName"/>
        <result column="assignee_id" property="assigneeId"/>
        <result column="assignee_name" property="assigneeName"/>
        <result column="assignee_dept_id" property="assigneeDeptId"/>
        <result column="assignee_dept_name" property="assigneeDeptName"/>
        <result column="cc_user_ids" property="ccUserIds"/>
        <result column="task_status" property="taskStatus"/>
        <result column="receive_time" property="receiveTime"/>
        <result column="deadline_time" property="deadlineTime"/>
        <result column="start_process_time" property="startProcessTime"/>
        <result column="complete_time" property="completeTime"/>
        <result column="handle_duration" property="handleDuration"/>
        <result column="is_read" property="isRead"/>
        <result column="is_urged" property="isUrged"/>
        <result column="urge_count" property="urgeCount"/>
        <result column="action_result" property="actionResult"/>
        <result column="action_comment" property="actionComment"/>
        <result column="sort_weight" property="sortWeight"/>
        <result column="ext_data" property="extData"/>
        <result column="deleted" property="deleted"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectTaskPage" resultMap="TaskInfoResultMap">
        SELECT * FROM task_info
        <where>
            deleted = 0
            <if test="query.assigneeId != null">
                AND assignee_id = #{query.assigneeId}
            </if>
            <if test="query.assigneeDeptId != null">
                AND assignee_dept_id = #{query.assigneeDeptId}
            </if>
            <if test="query.initiatorId != null">
                AND initiator_id = #{query.initiatorId}
            </if>
            <if test="query.taskStatus != null">
                AND task_status = #{query.taskStatus}
            </if>
            <if test="query.externalSystem != null and query.externalSystem != ''">
                AND external_system = #{query.externalSystem}
            </if>
            <if test="query.taskType != null and query.taskType != ''">
                AND task_type = #{query.taskType}
            </if>
            <if test="query.taskCategory != null and query.taskCategory != ''">
                AND task_category = #{query.taskCategory}
            </if>
            <if test="query.priority != null">
                AND priority = #{query.priority}
            </if>
            <if test="query.isRead != null">
                AND is_read = #{query.isRead}
            </if>
            <if test="query.keyword != null and query.keyword != ''">
                AND (
                    title LIKE CONCAT('%', #{query.keyword}, '%')
                    OR content LIKE CONCAT('%', #{query.keyword}, '%')
                    OR task_no LIKE CONCAT('%', #{query.keyword}, '%')
                    OR biz_key LIKE CONCAT('%', #{query.keyword}, '%')
                )
            </if>
        </where>
        ORDER BY
            sort_weight DESC,
            priority ASC,
            CASE WHEN deadline_time IS NOT NULL AND deadline_time &lt; SYSDATETIME() THEN 0 ELSE 1 END ASC,
            receive_time DESC
    </select>
</mapper>
